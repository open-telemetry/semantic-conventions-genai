{% import 'stability.j2' as stability %}
{% import 'entity_macros.j2' as entities %}
{% import 'signal_requirement_level.j2' as sr %}

{# Refinements and imported spans inherit the base span's `name`, so provider
   docs get it without repeating it. #}
{% macro span_name(name) -%}
{%- set templates = name.templates or [] -%}
{%- if templates | length == 1 -%}
**Span name** SHOULD be `{{ templates[0].pattern }}`.
{%- elif templates -%}
**Span name** SHOULD be the first of the following formats for which all attributes are available.
{% for t in templates %}
{{ loop.index }}. `{{ t.pattern }}`
{%- endfor %}
{%- endif %}
{%- if name.note %}
{%- if templates %}

{% endif %}
{{- name.note | trim }}
{%- endif %}
{%- endmacro %}

{% macro header(span, entity_registry=none) -%}
**Status:** {{ stability.badge(span.stability, span.deprecated) }}

{{ span.brief | trim }}
{%- if span.note %}

{{ span.note | trim }}{% endif %}
{%- if span.name and (span.name.templates or span.name.note) %}

{{ span_name(span.name) }}{% endif %}
{%- if "**Span kind" not in (span.note or "") %}

**Span kind** SHOULD be `{{ span.kind | upper }}`.{% endif %}
{%- if "**Span status" not in (span.note or "") %}

**Span status** SHOULD follow the [Recording Errors]({{ params.upstream_docs_base }}/docs/general/recording-errors.md) document.{% endif %}
{%- if span.entity_associations is sequence %}

**Entity Associations** The span SHOULD be associated with one of the following entities:
{% for e in span.entity_associations %}
{%- set entity_type = e.type if e is mapping else e %}
{%- if entity_registry %}
- [`{{ entity_type }}`]({{ entities.registry_url(entity_type, entity_registry) }})
{%- else %}
- `{{ entity_type }}`
{%- endif %}
{%- endfor %}
{%- endif %}

{{ sr.render(span.requirement_level) }}

{% endmacro %}
